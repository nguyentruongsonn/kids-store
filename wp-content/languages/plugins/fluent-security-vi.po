#: app/Services/TransStrings.php:571
msgid "Nothing is saved until you apply these."
msgstr "Không có gì được lưu cho đến khi bạn áp dụng những điều này."

#: app/Services/TransStrings.php:569
msgid "Nothing has changed in the files we checked."
msgstr "Không có gì thay đổi trong các tệp chúng tôi đã kiểm tra."

#: app/Services/TransStrings.php:564
