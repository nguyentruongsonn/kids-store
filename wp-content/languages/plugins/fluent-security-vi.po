#: app/Services/TransStrings.php:558
msgid "Not offered"
msgstr "Không được cung cấp"

#: app/Services/TransStrings.php:555
msgid "None of your themes come from WordPress.org, so there is nothing to compare them with."
msgstr "Không có chủ đề nào của bạn đến từ WordPress.org, vì vậy không có gì để so sánh."

#: app/Services/TransStrings.php:554
msgid "None of your plugins come from WordPress.org, so there is nothing to compare them with."
msgstr "Không có plugin nào của bạn đến từ WordPress.org, vì vậy không có gì để so sánh."

#: app/Services/TransStrings.php:550
msgid "Nobody is locked out by this. Setting up an app stays optional until you make it required in Settings."
msgstr "Không ai bị khóa bởi điều này. Việc thiết lập ứng dụng vẫn là tùy chọn cho đến khi bạn bắt buộc nó trong Cài đặt."

#: app/Services/TransStrings.php:549
msgid "Nobody has set up two-factor sign-in yet"
msgstr "Chưa ai thiết lập đăng nhập hai yếu tố"

#: app/Services/TransStrings.php:548
msgid "No, that is not my address"
msgstr "Không, đó không phải là địa chỉ của tôi"

#: app/Services/TransStrings.php:546
msgid "No username"
msgstr "Không có tên người dùng"

#: app/Services/TransStrings.php:540
msgid "No second step"
msgstr "Không có bước thứ hai"

#: app/Services/TransStrings.php:539
msgid "No scan has run yet. Run one first, so this step knows what to put back."
msgstr "Chưa có bản quét nào được chạy. Hãy chạy một bản trước, để bước này biết phải khôi phục những gì."

#: app/Services/TransStrings.php:536
msgid "No recommendations right now"
msgstr "Hiện tại không có khuyến nghị nào"

#: app/Services/TransStrings.php:535
msgid "No proxy detected"
msgstr "Không phát hiện proxy"

#: app/Services/TransStrings.php:532
msgid "No method is switched on"
msgstr "Không có phương thức nào được bật"

#: app/Services/TransStrings.php:526
msgid "No destination set"
msgstr "Chưa đặt đích đến"

#: app/Services/TransStrings.php:522
msgid "New users get a code by email and must enter it before the account is created."
msgstr "Người dùng mới nhận được mã qua email và phải nhập mã đó trước khi tài khoản được tạo."

#: app/Services/TransStrings.php:521
msgid "New since recorded"
msgstr "Mới kể từ khi ghi lại"

#: app/Services/TransStrings.php:516
msgid "Needs an app you create in Google Cloud Console."
msgstr "Cần một ứng dụng bạn tạo trong Google Cloud Console."

#: app/Services/TransStrings.php:507
msgid "Monthly, on the 1st"
msgstr "Hàng tháng, vào ngày 1"

#: app/Services/TransStrings.php:497
msgid "Manage on their profile"
msgstr "Quản lý trên hồ sơ của họ"

#: app/Services/TransStrings.php:496
msgid "Make it required"
msgstr "Đặt làm bắt buộc"

#: app/Services/TransStrings.php:494
msgid "Magic Login"
msgstr "Đăng nhập thần kỳ"

#: app/Services/TransStrings.php:486
msgid "Login, registration and password reset in one form. Visitors switch between them with a link."
msgstr "Đăng nhập, đăng ký và đặt lại mật khẩu trong một biểu mẫu. Khách truy cập chuyển đổi giữa chúng bằng một liên kết."

#: app/Services/TransStrings.php:484
msgid "Login page"
msgstr "Trang đăng nhập"

#: app/Services/TransStrings.php:481
msgid "Login alerts, magic links and two-factor codes all go out by email. FluentSMTP sends your site's email through a mail service you choose, which is far more reliable than the web server."
msgstr "Thông báo đăng nhập, liên kết ma thuật và mã xác thực hai yếu tố đều được gửi qua email. FluentSMTP gửi email của trang web của bạn thông qua một dịch vụ thư bạn chọn, đáng tin cậy hơn nhiều so với máy chủ web."

#: app/Services/TransStrings.php:468
msgid "Link address"
msgstr "Địa chỉ liên kết"

#: app/Services/TransStrings.php:466
msgid "Lets people request a reset link and choose a new password."
msgstr "Cho phép mọi người yêu cầu liên kết đặt lại và chọn mật khẩu mới."

#: app/Services/TransStrings.php:464
msgid "Let people sign in with a passkey"
msgstr "Cho phép mọi người đăng nhập bằng khóa bảo mật"

#: app/Services/TransStrings.php:463
msgid "Let people sign in to your other sites with the accounts on this one."
msgstr "Cho phép mọi người đăng nhập vào các trang web khác của bạn bằng tài khoản trên trang web này."

#: app/Services/TransStrings.php:460
msgid "Leave this as the default and they go where everyone else does."
msgstr "Để mặc định và họ sẽ đi đến nơi mọi người khác đi."

#: app/Services/TransStrings.php:459
msgid "Leave empty to use the site's admin email address."
msgstr "Để trống để sử dụng địa chỉ email quản trị của trang web."

#: app/Services/TransStrings.php:451
msgid "Last changed (UTC)"
msgstr "Thay đổi lần cuối (UTC)"

#: app/Services/TransStrings.php:446
msgid "Keep it to administrators and other powerful accounts. Alerts for roles that sign in all day stop getting read."
msgstr "Giữ nó cho quản trị viên và các tài khoản có quyền hạn khác. Các cảnh báo cho các vai trò đăng nhập cả ngày sẽ ngừng được đọc."

#: app/Services/TransStrings.php:442
msgid "Its settings are kept."
msgstr "Cài đặt của nó được giữ nguyên."

#: app/Services/TransStrings.php:440
msgid "It is on, but no role has been picked."
msgstr "Nó đã được bật, nhưng chưa có vai trò nào được chọn."

#: app/Services/TransStrings.php:437
msgid "In wp-config.php the secret stays out of the database and out of any database backup."
msgstr "Trong wp-config.php, bí mật vẫn nằm ngoài cơ sở dữ liệu và ngoài bất kỳ bản sao lưu cơ sở dữ liệu nào."

#: app/Services/TransStrings.php:431
msgid "If you use Jetpack, a mobile app, or a tool that posts to this site for you, leave XML-RPC unblocked."
msgstr "Nếu bạn sử dụng Jetpack, một ứng dụng di động hoặc một công cụ đăng bài lên trang web này cho bạn, hãy giữ XML-RPC không bị chặn."

#: app/Services/TransStrings.php:430
msgid "If you skip this, the app data stays unencrypted, as it is now. Everything keeps working."
msgstr "Nếu bạn bỏ qua điều này, dữ liệu ứng dụng vẫn không được mã hóa, như hiện tại. Mọi thứ vẫn hoạt động."

#: app/Services/TransStrings.php:427
msgid "If the allowed list is ever emptied, this restriction stops applying instead of locking everyone out. Adding %s to wp-config.php switches it off, along with the block list."
msgstr "Nếu danh sách cho phép bị làm trống, hạn chế này sẽ ngừng áp dụng thay vì khóa tất cả mọi người. Thêm %s vào wp-config.php sẽ tắt nó, cùng với danh sách chặn."

#: app/Services/TransStrings.php:417
msgid "How the plugin tells one visitor from another. Most sites can leave this alone; it matters when traffic reaches your site through a proxy."
msgstr "Cách plugin phân biệt khách truy cập này với khách truy cập khác. Hầu hết các trang web có thể bỏ qua điều này; nó quan trọng khi lưu lượng truy cập đến trang web của bạn thông qua một proxy."

#: app/Services/TransStrings.php:416
msgid "How often"
msgstr "Tần suất"

#: app/Services/TransStrings.php:415
msgid "How many wrong passwords one IP address gets before it is blocked."
msgstr "Một địa chỉ IP được phép nhập sai bao nhiêu mật khẩu trước khi bị chặn."

#: app/Services/TransStrings.php:414
msgid "How long logs are kept, and which roles can open wp-admin."
msgstr "Thời gian giữ nhật ký và những vai trò nào có thể mở wp-admin."

#: app/Services/TransStrings.php:412
msgid "Hide the side panel"
msgstr "Ẩn bảng điều khiển bên"

#: app/Services/TransStrings.php:409
msgid "Header your proxy puts the visitor's address in"
msgstr "Tiêu đề proxy của bạn đặt địa chỉ của khách truy cập vào"

#: app/Services/TransStrings.php:408
msgid "Header that carries the visitor's address"
msgstr "Tiêu đề mang địa chỉ của khách truy cập"

#: app/Services/TransStrings.php:405
msgid "Google pops up its own sign-in prompt, so there is no button to press. Your site's address has to be listed under Authorized JavaScript origins in your Google app."
msgstr "Google hiển thị lời nhắc đăng nhập riêng, vì vậy không có nút nào để nhấn. Địa chỉ trang web của bạn phải được liệt kê trong mục Nguồn gốc JavaScript được ủy quyền trong ứng dụng Google của bạn."

#: app/Services/TransStrings.php:396
msgid "Give the button a label and a link address."
msgstr "Đặt nhãn và địa chỉ liên kết cho nút."

#: app/Services/TransStrings.php:391
msgid "Get an email when a file on this site changes"
msgstr "Nhận email khi một tệp trên trang web này thay đổi"

#: app/Services/TransStrings.php:376
msgid "Folders WordPress did not put here"
msgstr "Thư mục WordPress không đặt ở đây"

#: app/Services/TransStrings.php:373
msgid "Findings you have set aside. Restore one to see it in the list again."
msgstr "Những phát hiện bạn đã tạm hoãn. Khôi phục một mục để xem lại trong danh sách."

#: app/Services/TransStrings.php:369
msgid "Fills in the fields below from your own visit. Nothing changes until you save."
msgstr "Điền vào các trường bên dưới từ lượt truy cập của bạn. Không có gì thay đổi cho đến khi bạn lưu."

#: app/Services/TransStrings.php:368
msgid "Filled in from your own visit. Check it, then save."
msgstr "Đã điền từ lượt truy cập của bạn. Kiểm tra rồi lưu."

#: app/Services/TransStrings.php:363
msgid "Failed logins are counted per address. While every visitor looks like %s, one person's failed attempts can lock everyone out."
msgstr "Các lần đăng nhập thất bại được tính theo địa chỉ. Trong khi mọi khách truy cập đều trông giống %s, các lần thử thất bại của một người có thể khóa tất cả mọi người."

#: app/Services/TransStrings.php:354
msgid "Everything looks good"
msgstr "Mọi thứ đều ổn"

#: app/Services/TransStrings.php:353
msgid "Everything here is off, so a password alone signs anyone in."
msgstr "Mọi thứ ở đây đều tắt, vì vậy chỉ cần mật khẩu là bất kỳ ai cũng có thể đăng nhập."

#: app/Services/TransStrings.php:351
msgid "Everyone who can use two-factor has set it up"
msgstr "Tất cả những người có thể sử dụng xác thực hai yếu tố đều đã thiết lập nó"

#: app/Services/TransStrings.php:350
msgid "Everyone signs in with a password alone. Turn on an authenticator app, passkeys or emailed codes and this page will show who has set one up."
msgstr "Mọi người đăng nhập chỉ bằng mật khẩu. Bật ứng dụng xác thực, khóa truy cập hoặc mã gửi qua email và trang này sẽ hiển thị ai đã thiết lập một trong số đó."

#: app/Services/TransStrings.php:349
msgid "Everyone can use it"
msgstr "Mọi người đều có thể sử dụng"

#: app/Services/TransStrings.php:346
msgid "Every visitor currently shows up as this one address."
msgstr "Mọi khách truy cập hiện tại đều hiển thị dưới cùng một địa chỉ này."

#: app/Services/TransStrings.php:345
msgid "Every visitor currently reaches this site under the same address, so the login limit cannot tell one from another."
msgstr "Mọi khách truy cập hiện tại đều truy cập trang này dưới cùng một địa chỉ, vì vậy giới hạn đăng nhập không thể phân biệt người này với người khác."

#: app/Services/TransStrings.php:344
msgid "Every visitor currently reaches this site from the same address, because a proxy in front of it has not been set up here. Until it is, this list is ignored, since allowing that one address would allow everyone."
msgstr "Mọi khách truy cập hiện tại đều truy cập trang này từ cùng một địa chỉ, vì một proxy phía trước nó chưa được thiết lập ở đây. Cho đến khi được thiết lập, danh sách này sẽ bị bỏ qua, vì cho phép một địa chỉ đó sẽ cho phép tất cả mọi người."

#: app/Services/TransStrings.php:342
msgid "Every role can register a passkey while login with a passkey is on. Turn that off to choose which roles may."
msgstr "Mọi vai trò đều có thể đăng ký khóa truy cập khi tính năng đăng nhập bằng khóa truy cập đang bật. Tắt nó đi để chọn vai trò nào được phép."

#: app/Services/TransStrings.php:341
msgid "Every method is switched off. Turn one on above first."
msgstr "Mọi phương thức đều đã tắt. Vui lòng bật một phương thức lên trước."

#: app/Services/TransStrings.php:340
msgid "Every line has to be true for the rule to apply."
msgstr "Mọi dòng phải đúng để quy tắc được áp dụng."

#: app/Services/TransStrings.php:323
msgid "Enter reply-to address"
msgstr "Nhập địa chỉ trả lời"

#: app/Services/TransStrings.php:320
msgid "Encrypt authenticator app data"
msgstr "Mã hóa dữ liệu ứng dụng xác thực"

#: app/Services/TransStrings.php:318
msgid "Emails you when the plugin blocks a login attempt. No more than one a minute, however many are blocked."
msgstr "Gửi email cho bạn khi plugin chặn một lần đăng nhập. Không quá một email mỗi phút, bất kể có bao nhiêu lần bị chặn."

#: app/Services/TransStrings.php:316
msgid "Emailed codes only. Nobody can set up an authenticator app or a passkey until one of those is switched on."
msgstr "Chỉ mã gửi qua email. Không ai có thể thiết lập ứng dụng xác thực hoặc khóa truy cập cho đến khi một trong số đó được bật."

#: app/Services/TransStrings.php:315
msgid "Emailed codes do not count here"
msgstr "Mã gửi qua email không được tính ở đây"

#: app/Services/TransStrings.php:314
msgid "Emailed codes are the weakest option"
msgstr "Mã gửi qua email là tùy chọn yếu nhất"

#: app/Services/TransStrings.php:313
msgid "Emailed codes are on, which needs nothing from the people signing in. Add the authenticator app if it suits your users, then choose who gets the second step."
msgstr "Mã gửi qua email đã bật, điều này không yêu cầu gì từ những người đăng nhập. Thêm ứng dụng xác thực nếu phù hợp với người dùng của bạn, sau đó chọn ai sẽ có bước thứ hai."

#: app/Services/TransStrings.php:310
msgid "Email design"
msgstr "Thiết kế email"

#: app/Services/TransStrings.php:307
msgid "Email Design"
msgstr "Thiết kế email"

#: app/Services/TransStrings.php:300
msgid "Each visitor is seen at their own address."
msgstr "Mỗi khách truy cập được nhìn thấy tại địa chỉ của riêng họ."

#: app/Services/TransStrings.php:298
msgid "Does this look right?"
msgstr "Cái này trông đúng không?"

#: app/Services/TransStrings.php:297
msgid "Do this if %s has lost the device the app was on. They can set up a new one from their profile."
msgstr "Thực hiện điều này nếu %s đã mất thiết bị có ứng dụng. Họ có thể thiết lập một thiết bị mới từ hồ sơ của mình."

#: app/Services/TransStrings.php:289
msgid "Detail boxes"
msgstr "Hộp chi tiết"

#: app/Services/TransStrings.php:277
msgid "Default text loaded. Save to keep it."
msgstr "Văn bản mặc định đã tải. Lưu để giữ lại."

#: app/Services/TransStrings.php:269
msgid "Current protection"
msgstr "Bảo vệ hiện tại"

#: app/Services/TransStrings.php:267
msgid "Counts the protections recommended for every site. Dismissed items and optional extras are left out."
msgstr "Đếm số biện pháp bảo vệ được đề xuất cho mỗi trang web. Các mục đã bỏ qua và tùy chọn bổ sung sẽ bị loại bỏ."

#: app/Services/TransStrings.php:266
msgid "Counts recommendations that passed or that you dismissed. File scan results are not included."
msgstr "Đếm các đề xuất đã được thông qua hoặc bạn đã bỏ qua. Kết quả quét tệp không được bao gồm."

#: app/Services/TransStrings.php:265
msgid "Counted per IP address. Each new attempt while blocked restarts the clock."
msgstr "Đếm theo địa chỉ IP. Mỗi lần thử mới khi bị chặn sẽ đặt lại đồng hồ."

#: app/Services/TransStrings.php:261
msgid "Could not load the security checks."
msgstr "Không thể tải kiểm tra bảo mật."

#: app/Services/TransStrings.php:257
msgid "Corner rounding"
msgstr "Bo tròn góc"

#: app/Services/TransStrings.php:254
msgid "Copy it from the Remote Auth screen on the site you are connecting."
msgstr "Sao chép từ màn hình Xác thực từ xa trên trang web bạn đang kết nối."

#: app/Services/TransStrings.php:246
msgid "Connection details from the other site"
msgstr "Chi tiết kết nối từ trang web khác"

#: app/Services/TransStrings.php:244
msgid "Connect this site with a free key to scan on a schedule and get an email when a file changes."
msgstr "Kết nối trang web này với khóa miễn phí để quét theo lịch trình và nhận email khi tệp thay đổi."

#: app/Services/TransStrings.php:243
msgid "Connect this site to scan on a schedule and get an email when a file changes."
msgstr "Kết nối trang web này để quét theo lịch trình và nhận email khi tệp thay đổi."

#: app/Services/TransStrings.php:242
msgid "Connect and run the first scan"
msgstr "Kết nối và chạy lần quét đầu tiên"

#: app/Services/TransStrings.php:237
msgid "Comparing your premium and custom plugins and themes with your snapshot."
msgstr "So sánh các plugin và giao diện cao cấp, tùy chỉnh của bạn với ảnh chụp nhanh."

#: app/Services/TransStrings.php:236
msgid "Comparing your files with the official copies on WordPress.org."
msgstr "So sánh tệp của bạn với các bản sao chính thức trên WordPress.org."

#: app/Services/TransStrings.php:235
msgid "Compare your WordPress files with the originals and flag any changes."
msgstr "So sánh các tệp WordPress của bạn với bản gốc và gắn cờ bất kỳ thay đổi nào."

#: app/Services/TransStrings.php:229
msgid "Choose one to continue."
msgstr "Chọn một để tiếp tục."

#: app/Services/TransStrings.php:228
msgid "Choose how often"
msgstr "Chọn tần suất"

#: app/Services/TransStrings.php:227
msgid "Choose at least one role."
msgstr "Chọn ít nhất một vai trò."

#: app/Services/TransStrings.php:224
msgid "Checks your WordPress files, plugins and themes against the official copies on WordPress.org and tells you what has changed."
msgstr "Kiểm tra các tệp, plugin và giao diện WordPress của bạn với các bản sao chính thức trên WordPress.org và cho bạn biết những gì đã thay đổi."

#: app/Services/TransStrings.php:218
msgid "Checked %s ago. Every WordPress file, and every plugin and theme from WordPress.org, matched the official copy."
msgstr "Đã kiểm tra %s trước. Mọi tệp WordPress, và mọi plugin và giao diện từ WordPress.org, đều khớp với bản sao chính thức."

#: app/Services/TransStrings.php:217
msgid "Checked %s ago. Each reinstall replaces every file with a fresh copy from WordPress.org, and once they are all done, sign everyone out again."
msgstr "Đã kiểm tra %s trước. Mỗi lần cài đặt lại sẽ thay thế mọi tệp bằng một bản sao mới từ WordPress.org, và một khi tất cả hoàn tất, hãy đăng xuất mọi người lần nữa."

#: app/Services/TransStrings.php:216
msgid "Checked"
msgstr "Đã kiểm tra"

#: app/Services/TransStrings.php:213
msgid "Changed since recorded"
msgstr "Đã thay đổi kể từ khi ghi lại"

#: app/Services/TransStrings.php:212
msgid "Changed"
msgstr "Đã thay đổi"

#: app/Services/TransStrings.php:211
msgid "Change the wording, colours and images on your sign up page."
msgstr "Thay đổi từ ngữ, màu sắc và hình ảnh trên trang đăng ký của bạn."

#: app/Services/TransStrings.php:210
msgid "Change the wording, colours and images on your login page."
msgstr "Thay đổi từ ngữ, màu sắc và hình ảnh trên trang đăng nhập của bạn."

#: app/Services/TransStrings.php:207
msgid "By default anyone can look up your usernames, which gives an attacker half of what they need."
msgstr "Theo mặc định, bất kỳ ai cũng có thể tra cứu tên người dùng của bạn, điều này cung cấp cho kẻ tấn công một nửa thông tin chúng cần."

#: app/Services/TransStrings.php:201
msgid "Browser details"
msgstr "Chi tiết trình duyệt"

#: app/Services/TransStrings.php:197
msgid "Blocked addresses"
msgstr "Địa chỉ bị chặn"

#: app/Services/TransStrings.php:193
msgid "Block all sign-ins from %s? Anyone else sharing this address will be blocked too. You can undo this under IP Rules."
msgstr "Chặn tất cả các lượt đăng nhập từ %s? Bất kỳ ai khác chia sẻ địa chỉ này cũng sẽ bị chặn. Bạn có thể hoàn tác điều này trong Quy tắc IP."

#: app/Services/TransStrings.php:189
msgid "Behind the sign-in form."
msgstr "Phía sau biểu mẫu đăng nhập."

#: app/Services/TransStrings.php:188
msgid "Behind the side panel, under any background image."
msgstr "Phía sau bảng điều khiển bên, bên dưới bất kỳ hình ảnh nền nào."

#: app/Services/TransStrings.php:186
msgid "Behind the box."
msgstr "Phía sau hộp."

#: app/Services/TransStrings.php:184
msgid "Basic"
msgstr "Cơ bản"

#: app/Services/TransStrings.php:180
msgid "Backup services, mobile apps and site management tools set up with one will stop working as soon as you save. Signing in through a browser is not affected."
msgstr "Các dịch vụ sao lưu, ứng dụng di động và công cụ quản lý trang web được thiết lập với một cái sẽ ngừng hoạt động ngay sau khi bạn lưu. Đăng nhập qua trình duyệt không bị ảnh hưởng."

#: app/Services/TransStrings.php:166
msgid "Ask for more than a password. Turn on the methods you want to offer, then decide which roles must use one."
msgstr "Yêu cầu nhiều hơn một mật khẩu. Bật các phương thức bạn muốn cung cấp, sau đó quyết định vai trò nào phải sử dụng một phương thức."

#: app/Services/TransStrings.php:161
msgid "Applies to no one"
msgstr "Không áp dụng cho ai"

#: app/Services/TransStrings.php:156
msgid "Anything connected with an application password will stop working"
msgstr "Mọi thứ liên quan đến mật khẩu ứng dụng sẽ ngừng hoạt động"

#: app/Services/TransStrings.php:154
msgid "Anyone who can read the user's inbox can read the code. Roles without emailed codes switched on above still need a passkey or the app."
msgstr "Bất kỳ ai có thể đọc hộp thư đến của người dùng đều có thể đọc mã. Các vai trò không bật mã qua email ở trên vẫn cần khóa truy cập hoặc ứng dụng."

#: app/Services/TransStrings.php:152
msgid "Anyone in these roles is refused from any other address, however they sign in."
msgstr "Bất kỳ ai trong các vai trò này sẽ bị từ chối truy cập từ bất kỳ địa chỉ nào khác, bất kể họ đăng nhập bằng cách nào."

#: app/Services/TransStrings.php:151
msgid "Any method, including an emailed code"
msgstr "Bất kỳ phương thức nào, bao gồm cả mã được gửi qua email"

#: app/Services/TransStrings.php:150
msgid "An older way for apps to sign in, now used mostly for guessing passwords. The WordPress mobile app may still need it."
msgstr "Một cách cũ hơn để các ứng dụng đăng nhập, hiện chủ yếu được sử dụng để đoán mật khẩu. Ứng dụng di động WordPress có thể vẫn cần nó."

#: app/Services/TransStrings.php:148
msgid "Allowed addresses"
msgstr "Địa chỉ được phép"

#: app/Services/TransStrings.php:147
msgid "Allow passkeys"
msgstr "Cho phép khóa truy cập"

#: app/Services/TransStrings.php:133
msgid "Adds a button to the login page that emails the user a sign-in link instead of asking for a password."
msgstr "Thêm nút vào trang đăng nhập để gửi email cho người dùng một liên kết đăng nhập thay vì yêu cầu mật khẩu."

#: app/Services/TransStrings.php:130
msgid "Address of the service in front of this site"
msgstr "Địa chỉ của dịch vụ phía trước trang này"

#: app/Services/TransStrings.php:129
msgid "Address headers on this request"
msgstr "Tiêu đề địa chỉ trên yêu cầu này"

#: app/Services/TransStrings.php:120
msgid "Add button"
msgstr "Thêm nút"

#: app/Services/TransStrings.php:117
msgid "Add a button"
msgstr "Thêm một nút"

#: app/Services/TransStrings.php:110
msgid "Accept these changes"
msgstr "Chấp nhận những thay đổi này"

#: app/Services/TransStrings.php:109
msgid "Accept and record"
msgstr "Chấp nhận và ghi lại"

#: app/Services/TransStrings.php:106
msgid "A step-by-step page for signing everyone out, putting files back and resetting passwords."
msgstr "Một trang hướng dẫn từng bước để đăng xuất tất cả mọi người, khôi phục tệp và đặt lại mật khẩu."

#: app/Services/TransStrings.php:105
msgid "A proxy sits in front of this site"
msgstr "Một proxy nằm phía trước trang này"

#: app/Services/TransStrings.php:104
msgid "A plugin or theme is on a version WordPress.org has never released"
msgstr "Một plugin hoặc giao diện đang ở phiên bản WordPress.org chưa bao giờ phát hành"

#: app/Services/TransStrings.php:103
msgid "A passkey or the authenticator app only"
msgstr "Chỉ khóa truy cập hoặc ứng dụng xác thực"

#: app/Services/TransStrings.php:102
msgid "A key is already in your wp-config.php. Switch this on to encrypt the app data."
msgstr "Một khóa đã có trong wp-config.php của bạn. Bật tùy chọn này để mã hóa dữ liệu ứng dụng."

#: app/Services/TransStrings.php:100
msgid "A firewall, CDN or similar service sits in front of this site. You will add its address next."
msgstr "Một tường lửa, CDN hoặc dịch vụ tương tự nằm phía trước trang này. Bạn sẽ thêm địa chỉ của nó tiếp theo."

#: app/Services/TransStrings.php:98
msgid "A count of successful, failed and blocked logins for the period. Nothing is sent if there were none."
msgstr "Số lượt đăng nhập thành công, thất bại và bị chặn trong kỳ. Không có gì được gửi nếu không có lượt nào."

#: app/Services/TransStrings.php:97
msgid "A code sent to their email address each time they sign in. Nothing to set up."
msgstr "Một mã được gửi đến địa chỉ email của họ mỗi khi họ đăng nhập. Không cần thiết lập gì."

#: app/Services/TransStrings.php:96
msgid "A code sent to the user's email address when they sign in. There is nothing for them to install."
msgstr "Một mã được gửi đến địa chỉ email của người dùng khi họ đăng nhập. Họ không cần cài đặt gì."

#: app/Services/TransStrings.php:95
msgid "A code from an app on their phone, such as Google Authenticator or Authy. No email needed."
msgstr "Một mã từ ứng dụng trên điện thoại của họ, chẳng hạn như Google Authenticator hoặc Authy. Không cần email."

#: app/Services/TransStrings.php:94
msgid "A code from an app on the user's phone. Once someone sets it up, they are asked for it every time they sign in."
msgstr "Một mã từ ứng dụng trên điện thoại của người dùng. Một khi ai đó thiết lập nó, họ sẽ được yêu cầu nhập mã đó mỗi khi đăng nhập."

#: app/Services/TransStrings.php:91
msgid "%s with no official copy"
msgstr "%s không có bản sao chính thức"

#: app/Services/TransStrings.php:89
msgid "%s will have to set one up the next time they sign in. Anyone already signed in is locked out of the admin area until they do."
msgstr "%s sẽ phải thiết lập một cái vào lần đăng nhập tiếp theo. Bất kỳ ai đã đăng nhập sẽ bị khóa khỏi khu vực quản trị cho đến khi họ thực hiện."

#: app/Services/TransStrings.php:88
msgid "%s versions not on WordPress.org"
msgstr "%s phiên bản không có trên WordPress.org"

#: app/Services/TransStrings.php:87
msgid "%s version not on WordPress.org"
msgstr "%s phiên bản không có trên WordPress.org"

#: app/Services/TransStrings.php:84
msgid "%s unexpected files"
msgstr "%s tệp không mong muốn"

#: app/Services/TransStrings.php:83
msgid "%s unexpected file"
msgstr "%s tệp không mong muốn"

#: app/Services/TransStrings.php:65
msgid "%s items are not from WordPress.org, so there is no official copy to compare them with."
msgstr "%s mục không phải từ WordPress.org, vì vậy không có bản sao chính thức để so sánh."

#: app/Services/TransStrings.php:63
msgid "%s item is not from WordPress.org, so there is no official copy to compare it with."
msgstr "%s mục không phải từ WordPress.org, vì vậy không có bản sao chính thức để so sánh."

#: app/Services/TransStrings.php:62
msgid "%s is set in wp-config.php, so the block list and the role restriction below are not being applied. Remove that line once your lists are fixed."
msgstr "%s được đặt trong wp-config.php, vì vậy danh sách chặn và hạn chế vai trò bên dưới không được áp dụng. Xóa dòng đó sau khi danh sách của bạn đã được sửa."

#: app/Services/TransStrings.php:47
msgid "%s files are not being watched because some plugins or themes are too large to record in full."
msgstr "%s tệp không được theo dõi vì một số plugin hoặc giao diện quá lớn để ghi lại đầy đủ."

#: app/Services/TransStrings.php:40
msgid "%s file is not being watched because one plugin or theme is too large to record in full."
msgstr "%s tệp không được theo dõi vì một plugin hoặc giao diện quá lớn để ghi lại đầy đủ."

#: app/Services/TransStrings.php:24
msgid "%s already get an emailed code, so nothing changes for them. Choose the first option to make them set up a passkey or the app instead."
msgstr "%s đã nhận được mã qua email, vì vậy không có gì thay đổi đối với họ. Chọn tùy chọn đầu tiên để họ thiết lập khóa truy cập hoặc ứng dụng thay thế."

#: app/Services/TransStrings.php:20
msgid "%d authenticator apps cannot be read. Those users are not locked out, but they will need to set the app up again."
msgstr "%d ứng dụng xác thực không thể đọc được. Những người dùng đó không bị khóa, nhưng họ sẽ cần thiết lập lại ứng dụng."

#: app/Services/TransStrings.php:19
msgid "%d authenticator app cannot be read. That user is not locked out, but they will need to set the app up again."
msgstr "%d ứng dụng xác thực không thể đọc được. Người dùng đó không bị khóa, nhưng họ sẽ cần thiết lập lại ứng dụng."

#: app/Services/TransStrings.php:16
msgid "%1s of %2s users who can use %3s have set one up"
msgstr "%1s trong số %2s người dùng có thể sử dụng %3s đã thiết lập một cái"

#: app/Services/TransStrings.php:15
msgid "%1s of %2s users set up"
msgstr "%1s trong số %2s người dùng đã thiết lập"

#: app/Services/SecurityChecks.php:304
msgid "This is the only check that can tell you a file was edited after somebody got in."
msgstr "Đây là lần kiểm tra duy nhất có thể cho bạn biết một tệp đã bị chỉnh sửa sau khi ai đó xâm nhập."

#: app/Services/SecurityChecks.php:303
msgid "Watch your WordPress files for changes"
msgstr "Theo dõi các tệp WordPress của bạn để biết các thay đổi"

#: app/Services/SecurityChecks.php:273
msgid "Right now anyone can look up the usernames on your site. A username is half of every login."
msgstr "Hiện tại, bất kỳ ai cũng có thể tìm kiếm tên người dùng trên trang web của bạn. Tên người dùng là một nửa của mỗi lần đăng nhập."

#: app/Services/SecurityChecks.php:261
msgid "Few sites still use it, and it is a favourite way to try thousands of passwords at once. Skip this if you rely on the WordPress mobile app or Jetpack."
msgstr "Ít trang web vẫn sử dụng nó, và đây là một cách yêu thích để thử hàng ngàn mật khẩu cùng một lúc. Bỏ qua điều này nếu bạn dựa vào ứng dụng di động WordPress hoặc Jetpack."

#: app/Services/SecurityChecks.php:260
msgid "Block the old remote sign-in route (XML-RPC)"
msgstr "Chặn tuyến đăng nhập từ xa cũ (XML-RPC)"

#: app/Services/SecurityChecks.php:247
msgid "If someone else signs in to an administrator account, you find out the same day. Keep it to roles that sign in rarely, so the emails stay worth reading."
msgstr "Nếu người khác đăng nhập vào tài khoản quản trị viên, bạn sẽ biết ngay trong cùng ngày. Hãy giữ điều này cho những vai trò ít đăng nhập, để các email vẫn đáng đọc."

#: app/Services/SecurityChecks.php:246
msgid "Get an email when an administrator signs in"
msgstr "Nhận email khi quản trị viên đăng nhập"

#: app/Services/SecurityChecks.php:191
msgid "Lets people add a code from an app or their email to their sign-in. A stolen password alone is then not enough to get in."
msgstr "Cho phép mọi người thêm mã từ một ứng dụng hoặc email của họ vào lần đăng nhập của họ. Một mật khẩu bị đánh cắp đơn thuần sẽ không đủ để truy cập."

#: app/Services/Onboarding.php:511
msgid "Hid usernames from the public."
msgstr "Đã ẩn tên người dùng khỏi công chúng."

#: app/Services/Onboarding.php:510
msgid "Blocked XML-RPC (an old remote publishing feature)."
msgstr "Đã chặn XML-RPC (một tính năng xuất bản từ xa cũ)."

#: app/Services/Onboarding.php:492
msgid "Use between 1 and 100 attempts, and a window of up to 1440 minutes (one day)."
msgstr "Sử dụng từ 1 đến 100 lần thử, và một khoảng thời gian lên đến 1440 phút (một ngày)."

#: app/Services/Onboarding.php:442
msgid "Saved the address of the proxy in front of this site."
msgstr "Đã lưu địa chỉ của proxy phía trước trang web này."

#: app/Services/Onboarding.php:313
msgid "A sign-in you did not make is the first sign of a stolen account, and an email is how you find out the same day."
msgstr "Một lần đăng nhập mà bạn không thực hiện là dấu hiệu đầu tiên của một tài khoản bị đánh cắp, và email là cách bạn tìm ra ngay trong cùng ngày."

#: app/Services/Onboarding.php:312
msgid "Want an email when important accounts sign in?"
msgstr "Bạn có muốn nhận email khi các tài khoản quan trọng đăng nhập không?"

#: app/Services/Onboarding.php:291
msgid "Each one closes something WordPress leaves open by default that most sites never use."
msgstr "Mỗi tùy chọn đóng một cái gì đó mà WordPress để mở theo mặc định mà hầu hết các trang web không bao giờ sử dụng."

#: app/Services/Onboarding.php:290
msgid "Turn these protections on?"
msgstr "Bật các biện pháp bảo vệ này lên không?"

#: app/Services/Onboarding.php:289
msgid "Protections"
msgstr "Các biện pháp bảo vệ"

#: app/Services/Onboarding.php:275
msgid "A low number stops password guessing, but set it too low and people who mistype their own password get locked out."
msgstr "Một số lượng thấp sẽ ngăn chặn việc đoán mật khẩu, nhưng nếu đặt quá thấp, những người gõ sai mật khẩu của mình sẽ bị khóa tài khoản."

#: app/Services/Onboarding.php:274
msgid "How many failed attempts before a visitor is blocked?"
msgstr "Bao nhiêu lần thử thất bại trước khi một khách truy cập bị chặn?"

#: app/Services/Onboarding.php:227
msgid "With a second step, a stolen password on its own is not enough to get in."
msgstr "Với một bước thứ hai, mật khẩu bị đánh cắp riêng lẻ là không đủ để đăng nhập."

#: app/Services/Onboarding.php:226
msgid "Add a second step when people sign in?"
msgstr "Thêm một bước thứ hai khi mọi người đăng nhập không?"

#: app/Services/Onboarding.php:159
msgid "Failed logins are counted per visitor address, so the site has to be seeing the real one."
msgstr "Các lần đăng nhập thất bại được tính theo địa chỉ của khách truy cập, vì vậy trang web phải thấy địa chỉ thật."

#: app/Services/Onboarding.php:158
msgid "Is this the address you are visiting from?"
msgstr "Đây có phải là địa chỉ bạn đang truy cập từ không?"

#: app/Services/Checks/Users/HiddenUsersCheck.php:113
msgid "Your database holds accounts that do not appear on your users list. Hiding an account this way is how someone keeps access after a break-in."
msgstr "Cơ sở dữ liệu của bạn chứa các tài khoản không xuất hiện trong danh sách người dùng của bạn. Việc ẩn tài khoản theo cách này là cách ai đó giữ quyền truy cập sau một vụ đột nhập."

#: app/Services/Checks/Users/AdminUsernameCheck.php:68
msgid "WordPress cannot rename an account. Create a new administrator, sign in as them, then delete the old one and assign its posts to the new account."
msgstr "WordPress không thể đổi tên một tài khoản. Hãy tạo một quản trị viên mới, đăng nhập bằng tài khoản đó, sau đó xóa tài khoản cũ và gán các bài đăng của nó cho tài khoản mới."

#. translators: %s: a file path
#: app/Services/Checks/Files/WatchedFilesCheck.php:272
msgid "%s (new)"
msgstr "%s (mới)"

#: app/Services/Checks/Files/UploadsExecutionCheck.php:124
msgid "Most hosts leave this open, so it is not a sign of a problem. Blocking it means a file that sneaks in through an upload form cannot run, but on your web server your host has to add the rule."
msgstr "Hầu hết các nhà cung cấp hosting để mở tính năng này, vì vậy nó không phải là dấu hiệu của một vấn đề. Chặn nó có nghĩa là một tệp tin lén lút qua biểu mẫu tải lên không thể chạy, nhưng trên máy chủ web của bạn, nhà cung cấp hosting của bạn phải thêm quy tắc."

#: app/Services/Checks/Files/UploadsExecutionCheck.php:123
msgid "Most hosts leave this open, so it is not a sign of a problem. Blocking it means a file that sneaks in through an upload form cannot run, and your images and documents are unaffected."
msgstr "Hầu hết các nhà cung cấp hosting để mở tính năng này, vì vậy nó không phải là dấu hiệu của một vấn đề. Chặn nó có nghĩa là một tệp tin lén lút qua biểu mẫu tải lên không thể chạy, và hình ảnh và tài liệu của bạn không bị ảnh hưởng."

#: app/Services/Checks/Files/UploadsExecutionCheck.php:104
msgid "Your site did not answer a test request from itself, so we could not check whether uploaded files can run as code. This is usually a hosting setting, and the check is optional anyway."
msgstr "Trang web của bạn không phản hồi yêu cầu kiểm tra từ chính nó, vì vậy chúng tôi không thể kiểm tra xem các tệp đã tải lên có thể chạy dưới dạng mã hay không. Đây thường là một cài đặt hosting, và việc kiểm tra này dù sao cũng là tùy chọn."

#: app/Services/Checks/Files/MuPluginsCheck.php:90
msgid "No extra files run on every page of your site"
msgstr "Không có tệp bổ sung nào chạy trên mỗi trang của trang web của bạn"

#: app/Services/Checks/Files/MuPluginsCheck.php:89
msgid "One of these files has changed. It cannot be switched off from the plugins screen, so find out who changed it."
msgstr "Một trong các tệp này đã thay đổi. Nó không thể tắt từ màn hình plugin, vì vậy hãy tìm hiểu ai đã thay đổi nó."

#: app/Services/Checks/Files/MuPluginsCheck.php:87
msgid "This file was not here last time we looked, and files in this folder run automatically without appearing on your plugins screen. Ask your host or developer whether they added it before doing anything else."
msgstr "Tệp này không có ở đây lần trước chúng tôi kiểm tra, và các tệp trong thư mục này tự động chạy mà không xuất hiện trên màn hình plugin của bạn. Hãy hỏi nhà cung cấp hosting hoặc nhà phát triển của bạn xem họ có thêm nó vào không trước khi làm bất cứ điều gì khác."

